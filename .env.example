# Copy this file to .env.local for local development,
# and set these as Environment Variables in your Netlify site settings for production.

# Postgres connection string (Netlify DB / Neon / Supabase / Railway all work)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Random secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
